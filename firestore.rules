rules_version = '2';

// Security rules for the private DSA learning console (src/dsa).
// Publish them in the Firebase console: Firestore Database › Rules.
//
// Only the one console account can read or write, and only under its own dsa/{uid} path.
// The UID below is that account's User UID from Authentication › Users. If the account is ever
// recreated, it gets a new UID: update it here and publish again.
service cloud.firestore {
  match /databases/{database}/documents {
    match /dsa/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == '8C0gcphHS7fhgU1VzRIF5Pum4UY2';
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
