    "dsa:examples": "node scripts/dsa-examples.js --course dsa",
    "design:check": "node scripts/check-dsa-content.js --course design",
    "design:compile": "node scripts/compile-content.js --course design",
    "design:examples": "node scripts/dsa-examples.js --course design",
    "design:test": "node --test src/dsa/viz/script/ src/dsa/viz/sims/",
    "design:swift": "swift test --package-path design-swift",
    "design:solutions": "swift test --package-path design-swift -Xswiftc -DSOLUTIONS",
    "content:check": "node scripts/check-dsa-content.js"
  },
  "dependencies": {
    "@firebase/analytics": "^0.10.26",
    "@firebase/app": "^0.16.7",
